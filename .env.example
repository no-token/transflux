# ============================================================
# Transflux部署配置模板（复制为 .env 使用）
#
# .env 只放「部署级」配置。业务配置不在这里：
#   - 后台账号密码：默认 admin / admin123，首次登录强制改密
#   - 各家翻译 API 密钥 / 优先级 / 额度 / 网关密钥 / 路由模式：
#     全部在后台可视化配置并持久化到 SQLite，热生效无需重启
# ============================================================

# ===== 服务端口 =====
PORT=3000

# ===== 数据库文件路径（相对路径锚定项目根目录）=====
DB_PATH=./data/usage.sqlite

# ===== 跨域白名单（逗号分隔完整 origin；生产请勿留空或使用 *）=====
# 示例：CORS_ORIGINS=https://your-app.example.com,http://localhost:8080
CORS_ORIGINS=

# ===== 网关对外密钥【首次建库初始值】=====
# 客户端调用 /translate、/usage 时经 Ocp-Apim-Subscription-Key 头传递（兼容 Authorization: Bearer）。
# 仅在首次建库时写入数据库，之后以后台「系统设置」修改为准（改密需二次确认，立即生效）。
AUTH_KEY=change-me-gateway-auth

# ===== 密钥加密主密钥【可选，生产推荐】=====
# 上游 API 密钥与网关密钥使用 AES-256-GCM 加密落库。
# 不设置时自动生成 data/.master.key 文件（0600）——请务必备份该文件，
# 丢失后已加密的密钥无法解密，需在后台重新填写。
# 多实例/容器部署建议显式设置 64 位 hex：
# MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
